# --- Required ---
ANTHROPIC_API_KEY=
COMPANY_NAME=Acme Exports

# Gmail (run `npm run auth` once to get the refresh token)
GMAIL_ADDRESS=export@yourcompany.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Safety mode ---
# dry   = read mail, decide, print what it WOULD do. Touches nothing in Gmail. (default)
# draft = save the reply as a Gmail draft for a human to press send
# send  = send the reply automatically
MODE=dry

# --- Optional ---
POLICY_PATH=policies/export-policy.md
POLL_SECONDS=20
CLASSIFY_MODEL=claude-haiku-5-5
REPLY_MODEL=claude-sonnet-5-5
MIN_CLASSIFY_CONFIDENCE=0.8
MIN_REPLY_CONFIDENCE=0.8
MAX_REPLIES_PER_SENDER_PER_DAY=3
LABEL_PREFIX=Autopilot
# Slack incoming webhook: gets a message whenever a human is needed or the bot is unhealthy
SLACK_WEBHOOK_URL=
